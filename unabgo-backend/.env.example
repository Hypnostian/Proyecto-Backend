# Copia este archivo como .env y ajusta los valores. El archivo .env nunca se sube al repositorio.

# local | testing | production (en production no se permite migrate:fresh)
APP_ENV=local
APP_PORT=8080

# Base de datos. Por defecto H2 en un archivo local (no hay que instalar nada).
DB_URL=jdbc:h2:file:./data/unabgo;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH;AUTO_SERVER=TRUE
DB_USER=sa
DB_PASSWORD=
# PostgreSQL (por ejemplo con docker compose up -d):
# DB_URL=jdbc:postgresql://localhost:5432/unabgo
# DB_USER=unabgo
# DB_PASSWORD=unabgo

# Tokens de acceso (equivalente a Sanctum): días de vigencia
TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------------------------
# Servicios externos (entrega 3). Todo es opcional: lo que no se configure queda desactivado y el
# endpoint correspondiente responde 503 con un mensaje claro. Nunca subas claves reales al repositorio.
# ---------------------------------------------------------------------------------------------

# Plataforma GPS de las Rutas UNAB: URL que devuelve el arreglo JSON de reportes (GET /api/v1/bus/live)
GPS_FEED_URL=
# Secreto compartido con los dispositivos a bordo para firmar el webhook (X-Signature = HMAC-SHA256 del cuerpo)
GPS_WEBHOOK_SECRET=

# Firebase: id del proyecto (para verificar el inicio de sesión con Google) y ruta al JSON de la cuenta de
# servicio (para enviar notificaciones push con FCM). Sin credenciales, el push solo se escribe en el log.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# Banu con IA: cualquier proveedor compatible con OpenAI (se llama a {BANU_LLM_URL}/chat/completions).
# Ejemplo Groq: BANU_LLM_URL=https://api.groq.com/openai/v1  BANU_LLM_MODEL=llama-3.1-8b-instant
# Ejemplo Ollama Cloud: BANU_LLM_URL=https://ollama.com/v1  BANU_LLM_MODEL=gpt-oss:20b  (la clave se crea en ollama.com/settings/keys)
BANU_LLM_URL=
BANU_LLM_KEY=
BANU_LLM_MODEL=
# Preguntas por minuto y por IP permitidas en POST /api/v1/banu/ask
BANU_RATE_LIMIT_PER_MINUTE=20

# API REST de WordPress de unab.edu.co para sincronizar los programas (POST /api/v1/admin/programs/sync)
UNAB_WP_URL=https://unab.edu.co/wp-json/wp/v2
