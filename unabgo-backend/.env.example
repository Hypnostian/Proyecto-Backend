# Copia este archivo como .env y ajusta los valores. El archivo .env nunca se sube al repositorio.

# local | testing | production (en production no se permite migrate:fresh)
APP_ENV=local
APP_PORT=8080

# Base de datos. Por defecto H2 en un archivo local (no hay que instalar nada).
DB_URL=jdbc:h2:file:./data/unabgo;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
DB_USER=sa
DB_PASSWORD=
# PostgreSQL (por ejemplo con docker compose up -d):
# DB_URL=jdbc:postgresql://localhost:5432/unabgo
# DB_USER=unabgo
# DB_PASSWORD=unabgo

# Tokens de acceso (equivalente a Sanctum): días de vigencia
TOKEN_TTL_DAYS=30

# Servicios externos (se integran en la entrega 3)
GPS_FEED_URL=
OLLAMA_API_KEY=
GROQ_API_KEY=
FIREBASE_PROJECT_ID=unabgo
FIREBASE_CREDENTIALS=
UNAB_WP_URL=https://unab.edu.co/wp-json/wp/v2
GPS_WEBHOOK_SECRET=
